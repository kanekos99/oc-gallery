<!doctype html>
<html lang="en">
  <head>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <link
      rel="stylesheet"
      type="text/css"
      href="{{ '/styles/common.css' | url }}"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="{{ '/styles/home.css' | url }}"
    />

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OC Gallery</title>
    <link
      rel="icon"
      type="image/png"
      href="{{ '/images/allie.png' | url }}"
    />
  </head>
  <body>
    <div class="main-body" id="main-body">
      <div class="container">
        <div
          class="pt-3 container-row"
        >
          <div class="sidebar">
            <img src="{{ '/assets/standee.png' | url }}" class="sidebar-img" />
            <div class="about-box">
              <img src="{{ '/assets/oc-gallery.png' | url }}" />
              <p>
                Welcome to my OC hell! <br /><br />
                This is a page for me to compile my characters. It will mostly
                remain as a WIP as I slowly add more OCs.
              </p>
            </div>
            <a href="https://kanekos.neocities.org/" class="sidebar-btn mt-2">
              <i class="fa fa-arrow-circle-left me-2" aria-hidden="true"></i>
              back to home
            </a>
          </div>
          <div class="chara-gallery-container pt-5 pb-5">
            {%- for world in collections.worlds -%}
            {% include 'world.njk' %}
            {%- endfor-%}
          </div>
        </div>
      </div>
    </div>

    <script src="{{ '/scripts/main.js' | url }}"></script>
  </body>
</html>
